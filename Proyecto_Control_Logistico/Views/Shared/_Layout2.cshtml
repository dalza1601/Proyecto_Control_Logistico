<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Control Logistico</title>
    <!-- base:css -->
    <link rel="stylesheet" href="~/vendors/typicons.font/font/typicons.css" sp-append-version="true">
    <link rel="stylesheet" href="~/vendors/css/vendor.bundle.base.css" sp-append-version="true">
    <!-- endinject -->
    <!-- plugin css for this page -->
    <!-- End plugin css for this page -->
    <!-- inject:css -->
    <link rel="stylesheet" href="~/css/vertical-layout-light/style.css" sp-append-version="true">

    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" sp-append-version="true">
    <!-- endinject -->
    <link rel="shortcut icon" href="~/images/favicon.png" />
    @await RenderSectionAsync("CSS", required: false)

</head>
<body>

    <div class="container-scroller">
        <!-- partial:partials/_navbar.html -->
        <partial name="_NavBar" />
        <!-- partial -->
        <div class="container-fluid page-body-wrapper">
            <!-- partial:partials/_sidebar.html -->
            <partial name="_SideBar" />
            <!-- partial -->
            <div class="main-panel">
                <div class="content-wrapper">
                    @RenderBody()
                    <partial name="_NotificationPanel" />
                </div>
                <!-- content-wrapper ends -->
                <!-- partial:partials/_footer.html -->
                <footer class="footer">
                    <div class="d-sm-flex justify-content-center justify-content-sm-between">
                        <span class="text-center text-sm-left d-block d-sm-inline-block">Copyright © <a href="https://www.cibertec.edu.pe/" target="_blank">Cibertec</a> 2026</span>
                        <span class="float-none float-sm-right d-block mt-1 mt-sm-0 text-center"> <a href="https://www.cibertec.edu.pe/" target="_blank"> Control Logistico </a></span>
                    </div>
                </footer>
                <!-- partial -->
            </div>
            <!-- main-panel ends -->
        </div>
        <!-- page-body-wrapper ends -->
    </div>
    <!-- container-scroller -->
    <!-- base:js -->
    <script src="~/vendors/js/vendor.bundle.base.js"></script>
    <!-- endinject -->
    <!-- Plugin js for this page-->
    <!-- End plugin js for this page-->
    <!-- inject:js -->
    <script src="~/js/off-canvas.js"></script>
    <script src="~/js/hoverable-collapse.js"></script>
    <script src="~/js/template.js"></script>
    @* <script src="~/js/settings.js"></script> *@
    <script src="~/js/todolist.js"></script>
    <!-- endinject -->
    <!-- plugin js for this page -->
    @* <script src="~/vendors/progressbar.js/progressbar.min.js"></script>
    <script src="~/vendors/chart.js/Chart.min.js"></script> *@
    <!-- End plugin js for this page -->
    <!-- Custom js for this page-->
    <script src="~/js/dashboard.js"></script>
    <script src="~/lib/sweet-alert/sweetalert2@11.js"></script>
    <script src="~/lib/bootstrap/bootstrap.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- End custom js for this page-->
</body>
</html>