@{
    ViewData["Title"] = "Compras";
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">

            <h4 class="mb-0">
                <i class="bi bi-cart-check"></i>
                Registro de Compra
            </h4>
        </div>
        <div class="card-body">

            
            
            <!-- Proveedor -->
            <div class="row mb-3">

                <div class="col-md-4">
                    <label for="txtNumberOrder" class="form-label fw-bold">
                        N° Orden
                    </label>

                    <input type="text"
                           id="txtNumberOrder"
                           class="form-control"
                           placeholder="Ingrese N° Orden">
                </div>

                <div class="col-md-12">
                    <label class="form-label fw-bold">Proveedor</label>
                    <select id="cmbProveedor" class="form-select">
                    </select>
                </div>

            </div>

            <!-- Botón -->
            <div class="d-flex justify-content-end mb-3">
                <button class="btn btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#modalDetalle">
                    <i class="bi bi-plus-circle"></i>
                    Agregar Producto
                </button>
            </div>
            <!-- Tabla -->
            <table class="table table-bordered" id="tblDetalle">
                <thead class="table-dark">
                    <tr>
                        <th>Producto</th>
                        <th class="text-center">Cantidad</th>
                        <th class="text-end">Costo</th>
                        <th class="text-end">Total</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
                <tfoot>

                    <tr>
                        <th colspan="3" class="text-end">TOTAL GENERAL</th>
                        <th class="text-end fw-bold fs-5 text-primary" id="lblTotalGeneral">S/ 0.00</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
            <!-- Botón Guardar -->

            <div class="d-flex justify-content-end mt-4">

                <button id="btnGuardarCompra"
                        type="button"
                        class="btn btn-success btn-lg">

                    <i class="bi bi-check-circle"></i>
                    Guardar Compra

                </button>

            </div>

        </div>
    </div>
</div>
<partial name="_ModalDetalle" />
@section Scripts {
    <script src="~/lib/data-table/dataTables.js"></script>
    <script type="text/javascript" src="/lib/toastr/toastr.min.js"></script>
    <script src="~/js/modules/purchase.js"></script>
}
@section CSS {
    <link rel="stylesheet" href="/lib/data-table/dataTables.dataTables.css" />
    <link rel="stylesheet" href="/lib/toastr/toastr.min.css" />
}