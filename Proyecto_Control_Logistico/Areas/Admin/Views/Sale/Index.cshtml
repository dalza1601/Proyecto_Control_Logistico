@model IEnumerable<Proyecto_Control_Logistico.Application.DTOs.SaleDTO>
@using Proyecto_Control_Logistico.Domain

@{
    ViewData["Title"] = "Ventas";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-sm-12">
            <h1 class="text-center text-dark">
                Historial de ventas
            </h1>
        </div>
    </div>

    <br />
    <br />

    <table class="table table-striped table-bordered" style="width: 100%">
        <thead>
            <tr>
                <th>N°</th>
                <th>Número de venta</th>
                <th>Cliente</th>
                <th>Fecha</th>
                <th>Total</th>
                <th>Estado</th>
                <th>Opciones</th>
            </tr>
        </thead>
        <tbody>
            @{
                var index = 1;
            }

            @foreach (var sale in Model)
            {
                <tr>
                    <td>@index</td>
                    <td>@sale.NumberSale</td>
                    <td>@sale.ClientName</td>
                    <td>@sale.DateSale.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>S/ @sale.TotalAmount.ToString("0.00")</td>
                    <td>
                        @if (sale.Status == Constants.SALE_STATUS_CANCELLED)
                        {
                            <span class="badge bg-danger">@sale.Status</span>
                        }
                        else if (sale.Status == Constants.SALE_STATUS_DELIVERED)
                        {
                            <span class="badge bg-success">@sale.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">@sale.Status</span>
                        }
                    </td>
                    <td>
                        <a asp-area="Admin"
                           asp-controller="Sale"
                           asp-action="Details"
                           asp-route-id="@sale.Id"
                           class="btn btn-info btn-sm">
                            Detalle
                        </a>
                    </td>
                </tr>

                index++;
            }
        </tbody>
    </table>
</div>