@{
    ViewData["Title"] = "Sales";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-sm-12">
            <h1 class="text-center text-dark">
                Ventas
            </h1>
            <br />
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#saleModal" onclick="openModalSale()">
                Nueva Venta
            </button>

        </div>
    </div>

    <br />
    <br />

    <table id="tbSales" class="table table-striped table-bordered" style="width: 100%">
        <thead>
            <tr>
                <th>N°</th>
                <th>Venta Nro</th>
                <th>Monto Total</th>
                <th>Opciones</th>
            </tr>
        </thead>
    </table>

</div>

<div class="modal fade" id="saleModal" tabindex="1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div id="saleModalContent"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/data-table/dataTables.js"></script>
    <script type="text/javascript" src="/lib/toastr/toastr.min.js"></script>
    <script src="~/js/modules/sale.js"></script>
}

@section CSS {
    <link rel="stylesheet" href="/lib/data-table/dataTables.dataTables.css" />
    <link rel="stylesheet" href="/lib/toastr/toastr.min.css" />
}