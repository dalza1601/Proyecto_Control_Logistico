@model Proyecto_Control_Logistico.Application.DTOs.SaleDTO

@{
    ViewData["Title"] = "Detalle de venta";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-sm-12">
            <h1 class="text-center text-dark">
                Detalle de venta
            </h1>
        </div>
    </div>

    <br />

    <div class="card mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <strong>Número de venta:</strong>
                    <p>@Model.NumberSale</p>
                </div>
                <div class="col-md-4">
                    <strong>Cliente:</strong>
                    <p>@Model.ClientName</p>
                </div>
                <div class="col-md-4">
                    <strong>Fecha:</strong>
                    <p>@Model.DateSale.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <div class="col-md-4">
                    <strong>Total:</strong>
                    <p>S/ @Model.TotalAmount.ToString("0.00")</p>
                </div>
                <div class="col-md-4">
                    <strong>Estado:</strong>
                    <p>
                        @if (Model.Status == "Anulado")
                        {
                            <span class="badge bg-danger">@Model.Status</span>
                        }
                        else if (Model.Status == "Entregado")
                        {
                            <span class="badge bg-success">@Model.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">@Model.Status</span>
                        }
                    </p>
                </div>
            </div>
        </div>
    </div>

    <table class="table table-striped table-bordered" style="width: 100%">
        <thead>
            <tr>
                <th>N°</th>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Precio unitario</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @{
                var index = 1;
            }

            @foreach (var detail in Model.Details)
            {
                <tr>
                    <td>@index</td>
                    <td>@detail.ProductName</td>
                    <td>@detail.Quantity.ToString("0.##")</td>
                    <td>S/ @detail.UnitPrice.ToString("0.00")</td>
                    <td>S/ @detail.TotalPrice.ToString("0.00")</td>
                </tr>

                index++;
            }
        </tbody>
    </table>

    <div class="mt-3">
        <a asp-area="Admin"
           asp-controller="Sale"
           asp-action="Index"
           class="btn btn-secondary">
            Volver
        </a>

        @if (Model.Status == "Registrado")
        {
            <form asp-area="Admin"
                  asp-controller="Sale"
                  asp-action="MarkAsReviewed"
                  asp-route-id="@Model.Id"
                  method="post"
                  class="d-inline">
                <button type="submit" class="btn btn-primary">
                    Marcar como revisado
                </button>
            </form>
        }
        @if (Model.Status == "Revisado")
        {
            <form asp-area="Admin"
                  asp-controller="Sale"
                  asp-action="MarkAsPendingShipment"
                  asp-route-id="@Model.Id"
                  method="post"
                  class="d-inline">
                <button type="submit" class="btn btn-warning">
                    Marcar pendiente de envío
                </button>
            </form>
        }

        @if (Model.Status == "Pendiente de envio" || Model.Status == "Pendiente de envío")
        {
            <form asp-area="Admin"
                  asp-controller="Sale"
                  asp-action="MarkAsDelivered"
                  asp-route-id="@Model.Id"
                  method="post"
                  class="d-inline">
                <button type="submit" class="btn btn-success">
                    Marcar entregado
                </button>
            </form>

            <form asp-area="Admin"
                  asp-controller="Sale"
                  asp-action="Cancel"
                  asp-route-id="@Model.Id"
                  method="post"
                  class="d-inline">
                <button type="submit" class="btn btn-danger">
                    Anular venta
                </button>
            </form>
        }
    </div>
</div>