@using Proyecto_Control_Logistico.Application.DTOs
@model SupplierDTO
@{
    ViewData["ButtonTitle"] = "Actualizar Proveedor";
}

<br />
<h3 class="text-center">Actualizar Proveedor</h3>
<br />

<form class="p-2" id="frmSupplier" asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mt-4">

        <div class="form-group row mb-1">
            <div class="col-3 col-form-label">
                <label asp-for="RUC"></label>
            </div>
            <div class="col-9 p-1">
                <input required name="RUC" asp-for="RUC" class="form-control" placeholder="Ingrese RUC" />
                <span asp-validation-for="RUC" class="text-danger"></span>
            </div>
        </div>
        <br />

        <div class="form-group row mb-1">
            <div class="col-3 col-form-label">
                <label asp-for="Name"></label>
            </div>
            <div class="col-9 p-1">
                <input required name="Name" asp-for="Name" class="form-control" placeholder="Ingrese Nombre" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>
        <br />

        <div class="form-group row mb-1">
            <div class="col-3 col-form-label">
                <label asp-for="Address"></label>
            </div>
            <div class="col-9 p-1">
                <input required name="Address" asp-for="Address" class="form-control" placeholder="Ingrese Direccion" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
        </div>
        <br />

        <div class="form-group row mb-1">
            <div class="col-3 col-form-label">
                <label asp-for="Phone"></label>
            </div>
            <div class="col-9 p-1">
                <input required name="Phone" asp-for="Phone" class="form-control" placeholder="Ingrese Telefono" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
        </div>
        <br />

        <div class="form-group row mb-1">
            <div class="col-3 col-form-label">
                <label asp-for="Email"></label>
            </div>
            <div class="col-9 p-1">
                <input required name="Email" asp-for="Email" class="form-control" placeholder="Ingrese Correo" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>
        <br />


    </div>

    <div class="modal-footer justify-content-center">
        <partial name="_VistaCrearVolver" />
    </div>

</form>
