@using Proyecto_Control_Logistico.Application.DTOs
@model WareHouseDTO
@{
    ViewData["ButtonTitle"] = "Actualizar Almacén";
}

<br />
<h3 class="text-center">Actualizar Almacén</h3>
<br />
<form id="frmWarehouse" asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="m-4">
        <div class="form-group row mb-1">
            <div class="col-3 col-form-label">
                <label asp-for="Name"></label>
            </div>
            <div class="col-9 p-1">
                <input required asp-for="Name" class="form-control" placeholder="Ingrese el nombre del almacén" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>
        <br />
        <div class="form-group row mb-1">
            <div class="col-3 col-form-label">
                <label asp-for="Address"></label>
            </div>
            <div class="col-9 p-1">
                <input required asp-for="Address" class="form-control" placeholder="Ingrese la dirección del almacén" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="modal-footer justify-content-center">
        <partial name="_VistaCrearVolver" />
    </div>
</form>