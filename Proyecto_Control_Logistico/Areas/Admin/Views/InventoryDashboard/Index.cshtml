@model dynamic
@{
    ViewData["Title"] = "Dashboard de Inventario";

    // ---------- DATOS DE RESPALDO (bórralos cuando conectes tu Model real) ----------
    var totalEntradas = Model != null ? (int)Model.TotalInputs : 18450m;
    var totalSalidas = Model != null ? (int)Model.TotalOutputs : 12980m;
    var saldoVentas = Model != null ? (decimal)Model.SalesBalance : 46230.50m;
    var productosActivos = Model != null ? (int)Model.ActiveProducts : 130;
    var almacenesActivos = Model != null ? (int)Model.ActiveWarehouses : 5;

    var labels = Model != null ? (IEnumerable<string>)Model.Labels : new List<string>{
        "01 Jun","05 Jun","10 Jun","15 Jun","20 Jun","25 Jun","30 Jun"
    };
    var serieEntradas = Model != null ? (IEnumerable<int>)Model.SerieInputs : new List<int> { 1200, 1850, 1600, 2100, 1750, 2400, 2100 };
    var serieSalidas = Model != null ? (IEnumerable<int>)Model.SerieOutputs : new List<int> { 900, 1100, 1400, 1250, 1600, 1500, 1800 };

    var almacenes = Model != null ? (IEnumerable<dynamic>)Model.Warehouses : new List<dynamic>{
        new { Nombre = "ALM-01 · Central",   Entradas = 5200, Salidas = 3100 },
        new { Nombre = "ALM-02 · Norte",     Entradas = 2100, Salidas = 1700 },
        new { Nombre = "ALM-03 · Sur",       Entradas = 1800, Salidas = 2200 },
        new { Nombre = "ALM-04 · Este",      Entradas = 1400, Salidas =  900 },
        new { Nombre = "ALM-05 · Oeste",     Entradas = 3300, Salidas = 2600 },
    };

    var movimientos = Model != null ? (IEnumerable<dynamic>)Model.LastMovements : new List<dynamic>{
        new { Producto="Cemento Portland 42.5kg", Almacen="ALM-01", Tipo="Entrada", Cantidad=100, Motivo="Compra de productos", Fecha=DateTime.Today },
        new { Producto="Fierro corrugado 1/2\"",  Almacen="ALM-03", Tipo="Salida",  Cantidad=45,  Motivo="Venta a cliente",     Fecha=DateTime.Today.AddDays(0) },
        new { Producto="Pintura latex 1gal",      Almacen="ALM-02", Tipo="Entrada", Cantidad=60,  Motivo="Compra de productos", Fecha=DateTime.Today.AddDays(-1) },
        new { Producto="Tubo PVC 4\"",             Almacen="ALM-05", Tipo="Salida",  Cantidad=30,  Motivo="Venta a cliente",     Fecha=DateTime.Today.AddDays(-1) },
        new { Producto="Clavos 3\" caja",          Almacen="ALM-01", Tipo="Salida",  Cantidad=12,  Motivo="Venta a cliente",     Fecha=DateTime.Today.AddDays(-2) },
        new { Producto="Yeso 25kg",                Almacen="ALM-04", Tipo="Entrada", Cantidad=80,  Motivo="Compra de productos", Fecha=DateTime.Today.AddDays(-2) },
    };

    decimal maxWarehouse = 1;
    foreach (var a in almacenes)
    { 
        maxWarehouse = Math.Max(maxWarehouse, Math.Max((decimal)a.Inputs, (decimal)a.Outputs));
    }
}

<div class="container-fluid px-3 px-md-4 py-4" style="max-width:1400px;">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
        <div>
            <div class="text-uppercase small text-secondary-emphasis fw-semibold mb-1" style="letter-spacing:.14em; font-size:11.5px;">
                Control de inventario
            </div>
            <h1 class="display-title mb-0">Entradas, salidas y saldo de ventas</h1>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <select class="form-select form-select-sm w-auto" aria-label="Rango de fechas">
                <option>Últimos 7 días</option>
                <option>Últimos 30 días</option>
                <option>Este mes</option>
                <option>Personalizado</option>
            </select>
            <select class="form-select form-select-sm w-auto" aria-label="Filtrar por almacén">
                <option>Todos los almacenes</option>
                @foreach (var a in almacenes)
                {
                    <option>@a.Name</option>
                }
            </select>
            <button class="btn btn-accent btn-sm" type="button">Exportar reporte</button>
        </div>
    </div>

    <!-- Hero: saldo de ventas -->
    <div class="card hero-card border-0 mb-4">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-4 p-4">
            <div>
                <div class="text-secondary small mb-1">Saldo de ventas del periodo</div>
                <div class="hero-value mono">S/ @saldoVentas.ToString("N2")</div>
                <div class="small text-secondary mt-2">
                    <span class="text-success fw-semibold">+@totalEntradas.ToString("N0") entradas</span> &nbsp;·&nbsp;
                    <span class="text-danger">-@totalSalidas.ToString("N0") salidas</span> &nbsp;·&nbsp;
                    @almacenesActivos almacenes activos
                </div>
            </div>
            <canvas id="sparkline" height="90" style="max-width:260px;"></canvas>
        </div>
    </div>

    <!-- KPIs -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <span class="badge rounded-pill badge-in mb-2">↑ Entradas</span>
                    <div class="fs-3 fw-bold mono">@totalEntradas.ToString("N0")</div>
                    <div class="text-secondary small">Unidades ingresadas en el periodo</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <span class="badge rounded-pill badge-out mb-2">↓ Salidas</span>
                    <div class="fs-3 fw-bold mono">@totalSalidas.ToString("N0")</div>
                    <div class="text-secondary small">Unidades despachadas / vendidas</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <span class="badge rounded-pill badge-warn mb-2">Saldo</span>
                    <div class="fs-3 fw-bold mono">S/ @saldoVentas.ToString("N0")</div>
                    <div class="text-secondary small">Ingreso neto por ventas</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <span class="badge rounded-pill badge-muted mb-2">Catálogo</span>
                    <div class="fs-3 fw-bold mono">@productosActivos</div>
                    <div class="text-secondary small">Productos con movimiento activo</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Grafico principal + balance por almacen -->
    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="section-title h6 fw-semibold mb-1">Entradas vs. salidas</h2>
                    <div class="text-secondary small mb-3">Evolución diaria de unidades movidas</div>
                    <div class="d-flex gap-3 mb-3 small text-secondary">
                        <span><i class="dot dot-in me-1"></i>Entradas</span>
                        <span><i class="dot dot-out me-1"></i>Salidas</span>
                    </div>
                    <div class="chart-wrap"><canvas id="movChart"></canvas></div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="section-title h6 fw-semibold mb-1">Balance por almacén</h2>
                    <div class="text-secondary small mb-3">Salidas (izquierda) frente a entradas (derecha)</div>
                    <div class="beam-wrap">
                        @foreach (var a in almacenes)
                        {
                            decimal inW = (decimal)a.Inputs / maxWarehouse * 100m;
                            decimal outW = (decimal)a.Outputs / maxWarehouse * 100m;
                            <div class="beam-row">
                                <div class="d-flex justify-content-between small text-secondary mb-1">
                                    <b class="text-body fw-semibold">@a.Name</b>
                                    <span><span class="text-danger">-@a.Outputs</span> / <span class="text-success">+@a.Inputs</span></span>
                                </div>
                                <div class="beam-track">
                                    <div class="beam-half justify-content-end">
                                        <div class="beam-out" style="width:@(outW.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                                    </div>
                                    <div class="beam-half">
                                        <div class="beam-in" style="width:@(inW.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de ultimos movimientos -->
    <div class="card">
        <div class="card-body">
            <h2 class="section-title h6 fw-semibold mb-1">Últimos movimientos</h2>
            <div class="text-secondary small mb-3">Detalle de entradas y salidas más recientes</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr class="text-secondary text-uppercase small">
                            <th>Producto</th>
                            <th>Almacén</th>
                            <th>Tipo</th>
                            <th>Cantidad</th>
                            <th>Motivo</th>
                            <th>Fecha</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in movimientos)
                        {
                            <tr>
                                <td class="fw-medium">@m.ProductName</td>
                                <td class="text-secondary">@m.WareHouse</td>
                                <td>
                                    <span class="badge rounded-pill @(m.MovementType == "Entrada" ? "badge-in" : "badge-out")">
                                        @(m.MovementType == "Entrada" ? "↑" : "↓") @m.MovementType
                                    </span>
                                </td>
                                <td class="mono">@m.Quantity</td>
                                <td class="text-secondary">@m.Motive</td>
                                <td class="text-secondary mono">@(((DateTime)m.Date).ToString("dd MMM"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/js/modules/wareHouseDashboard.js"></script>
}

@section CSS {
    <link rel="stylesheet" href="~/css/modules/wareHouseDashboardStyle.css" />
}