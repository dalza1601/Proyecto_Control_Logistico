@using Proyecto_Control_Logistico.Application.DTOs
@model CategoryDTO
@{
    ViewData["ButtonTitle"] = "Crear Categoría";
}

<br />

<h3 class="text-center">Crear un nuevo Articulo</h3>
<br />

<form asp-action="Create" method="POST">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="col offset-1 mt-4">
        <div class="form-group row">
            <div class="col-4">
                <label asp-for="Name"></label>
            </div>
            <div class="col-8">
                <input required asp-for="Name" class="from-control" placeholder="Ingrese nombre articulo" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>

        <br />

        <div class="form-group row">
            <div class="col-4">
                <label asp-for="Description"></label>
            </div>
            <div class="col-8">
                <input required asp-for="Description" class="from-control" placeholder="Ingrese descripción del articulo" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>

        <br />

    </div>

    <div class="modal-footer">
        <div class="form-group-row">
            <div class="col-8">
                <partial name="_VistaCrearVolver" />
            </div>
        </div>
    </div>
   
</form>