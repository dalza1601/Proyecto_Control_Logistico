@using Proyecto_Control_Logistico.Application.DTOs
@model CategoryDTO
@{
    ViewData["ButtonTitle"] = "Crear Categoría";
}

<br />

<h3 class="text-center">Crear una Nueva Categoria</h3>
<br />

<form id="frmCategory" asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="m-4">
        <div class="form-group row mb-1">
            <div class="col-3 col-form-label">
                <label asp-for="Name"></label>
            </div>
            <div class="col-9 p-1">
                <input required asp-for="Name" class="form-control" placeholder="Ingrese nombre articulo" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>
        <br />
        <div class="form-group row mb-1">
            <div class="col-3 col-form-label">
                <label asp-for="Description"></label>
            </div>
            <div class="col-9 p-1">
                <input required asp-for="Description" class="form-control" placeholder="Ingrese descripción del articulo" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>

        <br />

    </div>

    <div class="modal-footer justify-content-center">
        <partial name="_VistaCrearVolver" />
    </div>
   
</form>