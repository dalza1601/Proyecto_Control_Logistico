@model IEnumerable<Proyecto_Control_Logistico.Domain.Entities.CarritoItem>

@{
    ViewData["Title"] = "Compra Exitosa";
    decimal totalGeneral = Model?.Sum(i => i.SubTotal) ?? 0;
}

<div class="container mt-5 text-center">
    <div class="card border-success mb-3 shadow">
        <div class="card-header bg-success text-white fs-4">
            ¡Simulación de Compra Exitosa!
        </div>
        <div class="card-body text-success">
            <h5 class="card-title text-dark">Gracias por tu compra en nuestra tienda</h5>
            <p class="card-text text-dark">
                Tu pedido por un total de <strong>S/ @totalGeneral.ToString("0.00")</strong> ha sido procesado correctamente.
                <br />
                Será enviado a la dirección registrada: <strong class="text-primary">@ViewData["DireccionCliente"]</strong>.
            </p>
            <hr />
            <div class="text-start text-dark mt-3">
                <h6>Detalle de los productos adquiridos:</h6>
                <ul>
                    @foreach (var item in Model)
                    {
                        <li>@item.Cantidad x @item.Nombre - (S/ @item.SubTotal.ToString("0.00"))</li>
                    }
                </ul>
            </div>

            <a asp-action="Index" class="btn btn-primary mt-4">Realizar un nuevo pedido</a>
        </div>
    </div>
</div>